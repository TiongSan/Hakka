  "items": [
    {
      "id": 1,
      "dialect": "sixian",
      "dialectLabel": "四縣",
      "text": "臺灣歷史上最可憐个就是義民",
      "sourcePerson": "李能棋",
      "sourceType": "臺灣客語語料庫・口語人物誌",
      "sourceUrl": "https://corpus.hakka.gov.tw/"
    },
    {
      "id": 2,
      "dialect": "sixian",
      "dialectLabel": "四縣",
      "text": "這位有講呢",
      "sourcePerson": "李能棋",
      "sourceType": "臺灣客語語料庫・口語人物誌",
      "sourceUrl": "https://corpus.hakka.gov.tw/"
    },
    {
      "id": 3,
      "dialect": "sixian",
      "dialectLabel": "四縣",
      "text": "有兜仔早期个學老人",
      "sourcePerson": "李能棋",
      "sourceType": "臺灣客語語料庫・口語人物誌",
      "sourceUrl": "https://corpus.hakka.gov.tw/"
    },
    {
      "id": 4,
      "dialect": "sixian",
      "dialectLabel": "四縣",
      "text": "就講麼个",
      "sourcePerson": "李能棋",
      "sourceType": "臺灣客語語料庫・口語人物誌",
      "sourceUrl": "https://corpus.hakka.gov.tw/"
    },
    {
      "id": 5,
      "dialect": "sixian",
      "dialectLabel": "四縣",
      "text": "客家人分清朝政府收買摎佢打",
      "sourcePerson": "李能棋",
      "sourceType": "臺灣客語語料庫・口語人物誌",
      "sourceUrl": "https://corpus.hakka.gov.tw/"
    },
    {
      "id": 6,
      "dialect": "sixian",
      "dialectLabel": "四縣",
      "text": "你看歷史上",
      "sourcePerson": "李能棋",
      "sourceType": "臺灣客語語料庫・口語人物誌",
      "sourceUrl": "https://corpus.hakka.gov.tw/"
    },
    {
      "id": 7,
      "dialect": "sixian",
      "dialectLabel": "四縣",
      "text": "閩客械鬥摎漳泉",
      "sourcePerson": "李能棋",
      "sourceType": "臺灣客語語料庫・口語人物誌",
      "sourceUrl": "https://corpus.hakka.gov.tw/"
    },
    {
      "id": 8,
      "dialect": "sixian",
      "dialectLabel": "四縣",
      "text": "閩客个打鬥當少",
      "sourcePerson": "李能棋",
      "sourceType": "臺灣客語語料庫・口語人物誌",
      "sourceUrl": "https://corpus.hakka.gov.tw/"
    },
    {
      "id": 9,
      "dialect": "sixian",
      "dialectLabel": "四縣",
      "text": "當然客家人較少",
      "sourcePerson": "李能棋",
      "sourceType": "臺灣客語語料庫・口語人物誌",
      "sourceUrl": "https://corpus.hakka.gov.tw/"
    },
    {
      "id": 10,
      "dialect": "sixian",
      "dialectLabel": "四縣",
      "text": "逐到山肚項去啊",
      "sourcePerson": "李能棋",
      "sourceType": "臺灣客語語料庫・口語人物誌",
      "sourceUrl": "https://corpus.hakka.gov.tw/"
    },
    {
      "id": 11,
      "dialect": "sixian",
      "dialectLabel": "四縣",
      "text": "像𠊎做田野調查",
      "sourcePerson": "彭啟源",
      "sourceType": "臺灣客語語料庫・口語人物誌",
      "sourceUrl": "https://corpus.hakka.gov.tw/"
    },
    {
      "id": 12,
      "dialect": "sixian",
      "dialectLabel": "四縣",
      "text": "木柵个山肚就有人寫堂號",
      "sourcePerson": "彭啟源",
      "sourceType": "臺灣客語語料庫・口語人物誌",
      "sourceUrl": "https://corpus.hakka.gov.tw/"
    },
    {
      "id": 13,
      "dialect": "sixian",
      "dialectLabel": "四縣",
      "text": "佢不見得係客人",
      "sourcePerson": "彭啟源",
      "sourceType": "臺灣客語語料庫・口語人物誌",
      "sourceUrl": "https://corpus.hakka.gov.tw/"
    },
    {
      "id": 14,
      "dialect": "sixian",
      "dialectLabel": "四縣",
      "text": "無法度證明佢係客人抑毋係客人",
      "sourcePerson": "彭啟源",
      "sourceType": "臺灣客語語料庫・口語人物誌",
      "sourceUrl": "https://corpus.hakka.gov.tw/"
    },
    {
      "id": 15,
      "dialect": "sixian",
      "dialectLabel": "四縣",
      "text": "吂證明出來",
      "sourcePerson": "彭啟源",
      "sourceType": "臺灣客語語料庫・口語人物誌",
      "sourceUrl": "https://corpus.hakka.gov.tw/"
    },
    {
      "id": 16,
      "dialect": "sixian",
      "dialectLabel": "四縣",
      "text": "𠊎該央時有做臺北新故鄉个時節",
      "sourcePerson": "彭啟源",
      "sourceType": "臺灣客語語料庫・口語人物誌",
      "sourceUrl": "https://corpus.hakka.gov.tw/"
    },
    {
      "id": 17,
      "dialect": "sixian",
      "dialectLabel": "四縣",
      "text": "有落去做調查",
      "sourcePerson": "彭啟源",
      "sourceType": "臺灣客語語料庫・口語人物誌",
      "sourceUrl": "https://corpus.hakka.gov.tw/"
    },
    {
      "id": 18,
      "dialect": "sixian",
      "dialectLabel": "四縣",
      "text": "毋係𠊎落去",
      "sourcePerson": "彭啟源",
      "sourceType": "臺灣客語語料庫・口語人物誌",
      "sourceUrl": "https://corpus.hakka.gov.tw/"
    },
    {
      "id": 19,
      "dialect": "sixian",
      "dialectLabel": "四縣",
      "text": "𠊎个學生仔這兜",
      "sourcePerson": "彭啟源",
      "sourceType": "臺灣客語語料庫・口語人物誌",
      "sourceUrl": "https://corpus.hakka.gov.tw/"
    },
    {
      "id": 20,
      "dialect": "sixian",
      "dialectLabel": "四縣",
      "text": "有摎𠊎回報",
      "sourcePerson": "彭啟源",
      "sourceType": "臺灣客語語料庫・口語人物誌",
      "sourceUrl": "https://corpus.hakka.gov.tw/"
    },
    {
      "id": 21,
      "dialect": "sixian",
      "dialectLabel": "四縣",
      "text": "結果𠊎行到這",
      "sourcePerson": "彭啟源",
      "sourceType": "臺灣客語語料庫・口語人物誌",
      "sourceUrl": "https://corpus.hakka.gov.tw/"
    },
    {
      "id": 22,
      "dialect": "sixian",
      "dialectLabel": "四縣",
      "text": "今晡日",
      "sourcePerson": "彭啟源",
      "sourceType": "臺灣客語語料庫・口語人物誌",
      "sourceUrl": "https://corpus.hakka.gov.tw/"
    },
    {
      "id": 23,
      "dialect": "sixian",
      "dialectLabel": "四縣",
      "text": "𫣆俚客家人毋係有戴",
      "sourcePerson": "彭啟源",
      "sourceType": "臺灣客語語料庫・口語人物誌",
      "sourceUrl": "https://corpus.hakka.gov.tw/"
    },
    {
      "id": 24,
      "dialect": "sixian",
      "dialectLabel": "四縣",
      "text": "乜毋係無一定寫堂",
      "sourcePerson": "彭啟源",
      "sourceType": "臺灣客語語料庫・口語人物誌",
      "sourceUrl": "https://corpus.hakka.gov.tw/"
    },
    {
      "id": 25,
      "dialect": "sixian",
      "dialectLabel": "四縣",
      "text": "就來二〇一〇年个時節",
      "sourcePerson": "黃永達",
      "sourceType": "臺灣客語語料庫・口語人物誌",
      "sourceUrl": "https://corpus.hakka.gov.tw/"
    },
    {
      "id": 26,
      "dialect": "sixian",
      "dialectLabel": "四縣",
      "text": "社群網路呢就開始了",
      "sourcePerson": "黃永達",
      "sourceType": "臺灣客語語料庫・口語人物誌",
      "sourceUrl": "https://corpus.hakka.gov.tw/"
    },
    {
      "id": 27,
      "dialect": "sixian",
      "dialectLabel": "四縣",
      "text": "影響著客家莊語言个情形啦",
      "sourcePerson": "黃永達",
      "sourceType": "臺灣客語語料庫・口語人物誌",
      "sourceUrl": "https://corpus.hakka.gov.tw/"
    },
    {
      "id": 28,
      "dialect": "sixian",
      "dialectLabel": "四縣",
      "text": "仰般這兜社群網路咧",
      "sourcePerson": "黃永達",
      "sourceType": "臺灣客語語料庫・口語人物誌",
      "sourceUrl": "https://corpus.hakka.gov.tw/"
    },
    {
      "id": 29,
      "dialect": "sixian",
      "dialectLabel": "四縣",
      "text": "到尾在該網路頂高咧",
      "sourcePerson": "黃永達",
      "sourceType": "臺灣客語語料庫・口語人物誌",
      "sourceUrl": "https://corpus.hakka.gov.tw/"
    },
    {
      "id": 30,
      "dialect": "sixian",
      "dialectLabel": "四縣",
      "text": "大家會結群嘛",
      "sourcePerson": "黃永達",
      "sourceType": "臺灣客語語料庫・口語人物誌",
      "sourceUrl": "https://corpus.hakka.gov.tw/"
    },
    {
      "id": 31,
      "dialect": "sixian",
      "dialectLabel": "四縣",
      "text": "該一群一群",
      "sourcePerson": "黃永達",
      "sourceType": "臺灣客語語料庫・口語人物誌",
      "sourceUrl": "https://corpus.hakka.gov.tw/"
    },
    {
      "id": 32,
      "dialect": "sixian",
      "dialectLabel": "四縣",
      "text": "大家就試看仔用客話來寫",
      "sourcePerson": "黃永達",
      "sourceType": "臺灣客語語料庫・口語人物誌",
      "sourceUrl": "https://corpus.hakka.gov.tw/"
    },
    {
      "id": 33,
      "dialect": "sixian",
      "dialectLabel": "四縣",
      "text": "用客話來寫",
      "sourcePerson": "黃永達",
      "sourceType": "臺灣客語語料庫・口語人物誌",
      "sourceUrl": "https://corpus.hakka.gov.tw/"
    },
    {
      "id": 34,
      "dialect": "sixian",
      "dialectLabel": "四縣",
      "text": "客家莊个事情𠊎會緊傳上去",
      "sourcePerson": "黃永達",
      "sourceType": "臺灣客語語料庫・口語人物誌",
      "sourceUrl": "https://corpus.hakka.gov.tw/"
    },
    {
      "id": 35,
      "dialect": "sixian",
      "dialectLabel": "四縣",
      "text": "二〇一〇年就有開始",
      "sourcePerson": "黃永達",
      "sourceType": "臺灣客語語料庫・口語人物誌",
      "sourceUrl": "https://corpus.hakka.gov.tw/"
    },
    {
      "id": 36,
      "dialect": "sixian",
      "dialectLabel": "四縣",
      "text": "赤牛",
      "sourcePerson": "龔萬灶",
      "sourceType": "臺灣客語語料庫・口語人物誌",
      "sourceUrl": "https://corpus.hakka.gov.tw/"
    },
    {
      "id": 37,
      "dialect": "sixian",
      "dialectLabel": "四縣",
      "text": "𫣆赤牛去拉車仔",
      "sourcePerson": "龔萬灶",
      "sourceType": "臺灣客語語料庫・口語人物誌",
      "sourceUrl": "https://corpus.hakka.gov.tw/"
    },
    {
      "id": 38,
      "dialect": "sixian",
      "dialectLabel": "四縣",
      "text": "佢較耐旱啦",
      "sourcePerson": "龔萬灶",
      "sourceType": "臺灣客語語料庫・口語人物誌",
      "sourceUrl": "https://corpus.hakka.gov.tw/"
    },
    {
      "id": 39,
      "dialect": "sixian",
      "dialectLabel": "四縣",
      "text": "毋使水啊",
      "sourcePerson": "龔萬灶",
      "sourceType": "臺灣客語語料庫・口語人物誌",
      "sourceUrl": "https://corpus.hakka.gov.tw/"
    },
    {
      "id": 40,
      "dialect": "sixian",
      "dialectLabel": "四縣",
      "text": "所以佢就大路項行做得啊",
      "sourcePerson": "龔萬灶",
      "sourceType": "臺灣客語語料庫・口語人物誌",
      "sourceUrl": "https://corpus.hakka.gov.tw/"
    },
    {
      "id": 41,
      "dialect": "sixian",
      "dialectLabel": "四縣",
      "text": "水牛拉車仔就較無適當",
      "sourcePerson": "龔萬灶",
      "sourceType": "臺灣客語語料庫・口語人物誌",
      "sourceUrl": "https://corpus.hakka.gov.tw/"
    },
    {
      "id": 42,
      "dialect": "sixian",
      "dialectLabel": "四縣",
      "text": "因為佢愛水",
      "sourcePerson": "龔萬灶",
      "sourceType": "臺灣客語語料庫・口語人物誌",
      "sourceUrl": "https://corpus.hakka.gov.tw/"
    },
    {
      "id": 43,
      "dialect": "sixian",
      "dialectLabel": "四縣",
      "text": "不時愛搵一下浴",
      "sourcePerson": "龔萬灶",
      "sourceType": "臺灣客語語料庫・口語人物誌",
      "sourceUrl": "https://corpus.hakka.gov.tw/"
    },
    {
      "id": 44,
      "dialect": "sixian",
      "dialectLabel": "四縣",
      "text": "故所水牛就旦勢就田項做事",
      "sourcePerson": "龔萬灶",
      "sourceType": "臺灣客語語料庫・口語人物誌",
      "sourceUrl": "https://corpus.hakka.gov.tw/"
    },
    {
      "id": 45,
      "dialect": "sixian",
      "dialectLabel": "四縣",
      "text": "田項駛牛个",
      "sourcePerson": "龔萬灶",
      "sourceType": "臺灣客語語料庫・口語人物誌",
      "sourceUrl": "https://corpus.hakka.gov.tw/"
    },
    {
      "id": 46,
      "dialect": "sixian",
      "dialectLabel": "四縣",
      "text": "犁田這兜",
      "sourcePerson": "龔萬灶",
      "sourceType": "臺灣客語語料庫・口語人物誌",
      "sourceUrl": "https://corpus.hakka.gov.tw/"
    },
    {
      "id": 47,
      "dialect": "sixian",
      "dialectLabel": "四縣",
      "text": "你有識聽人講𫣆客人無愛食牛肉無",
      "sourcePerson": "龔萬灶",
      "sourceType": "臺灣客語語料庫・口語人物誌",
      "sourceUrl": "https://corpus.hakka.gov.tw/"
    },
    {
      "id": 48,
      "dialect": "sixian",
      "dialectLabel": "四縣",
      "text": "就係因為這",
      "sourcePerson": "龔萬灶",
      "sourceType": "臺灣客語語料庫・口語人物誌",
      "sourceUrl": "https://corpus.hakka.gov.tw/"
    },
    {
      "id": 49,
      "dialect": "sixian",
      "dialectLabel": "四縣",
      "text": "這牛仔係耕田用个",
      "sourcePerson": "龔萬灶",
      "sourceType": "臺灣客語語料庫・口語人物誌",
      "sourceUrl": "https://corpus.hakka.gov.tw/"
    },
    {
      "id": 50,
      "dialect": "sixian",
      "dialectLabel": "四縣",
      "text": "佢毋係分人食个啊",
      "sourcePerson": "龔萬灶",
      "sourceType": "臺灣客語語料庫・口語人物誌",
      "sourceUrl": "https://corpus.hakka.gov.tw/"
    },
    {
      "id": 51,
      "dialect": "sixian",
      "dialectLabel": "四縣",
      "text": "害啊死天啊無天良",
      "sourcePerson": "古蘭妹",
      "sourceType": "臺灣客語語料庫・口語人物誌",
      "sourceUrl": "https://corpus.hakka.gov.tw/"
    },
    {
      "id": 52,
      "dialect": "sixian",
      "dialectLabel": "四縣",
      "text": "有心救主理不足啊",
      "sourcePerson": "古蘭妹",
      "sourceType": "臺灣客語語料庫・口語人物誌",
      "sourceUrl": "https://corpus.hakka.gov.tw/"
    },
    {
      "id": 53,
      "dialect": "sixian",
      "dialectLabel": "四縣",
      "text": "何人幫忙出啦主張哪",
      "sourcePerson": "古蘭妹",
      "sourceType": "臺灣客語語料庫・口語人物誌",
      "sourceUrl": "https://corpus.hakka.gov.tw/"
    },
    {
      "id": 54,
      "dialect": "sixian",
      "dialectLabel": "四縣",
      "text": "班底愛二十儕喔",
      "sourcePerson": "黃秀滿",
      "sourceType": "臺灣客語語料庫・口語人物誌",
      "sourceUrl": "https://corpus.hakka.gov.tw/"
    },
    {
      "id": 55,
      "dialect": "sixian",
      "dialectLabel": "四縣",
      "text": "出一隻皇帝",
      "sourcePerson": "黃秀滿",
      "sourceType": "臺灣客語語料庫・口語人物誌",
      "sourceUrl": "https://corpus.hakka.gov.tw/"
    },
    {
      "id": 56,
      "dialect": "sixian",
      "dialectLabel": "四縣",
      "text": "抑出一隻官",
      "sourcePerson": "黃秀滿",
      "sourceType": "臺灣客語語料庫・口語人物誌",
      "sourceUrl": "https://corpus.hakka.gov.tw/"
    },
    {
      "id": 57,
      "dialect": "sixian",
      "dialectLabel": "四縣",
      "text": "最多愛兩個",
      "sourcePerson": "黃秀滿",
      "sourceType": "臺灣客語語料庫・口語人物誌",
      "sourceUrl": "https://corpus.hakka.gov.tw/"
    },
    {
      "id": 58,
      "dialect": "sixian",
      "dialectLabel": "四縣",
      "text": "吂有做著戲个人",
      "sourcePerson": "黃秀滿",
      "sourceType": "臺灣客語語料庫・口語人物誌",
      "sourceUrl": "https://corpus.hakka.gov.tw/"
    },
    {
      "id": 59,
      "dialect": "sixian",
      "dialectLabel": "四縣",
      "text": "就愛包這个",
      "sourcePerson": "黃秀滿",
      "sourceType": "臺灣客語語料庫・口語人物誌",
      "sourceUrl": "https://corpus.hakka.gov.tw/"
    },
    {
      "id": 60,
